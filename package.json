{
  "name": "@xrjprogram/chemiation",
  "version": "1.2.1",
  "description": "Chemical reaction principle and mechanism simulation studio with interactive pseudo-3D canvas visualization",
  "main": "index.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "server": "node server/server.js",
    "serve:static": "npx serve .",
    "test": "node test/test.js",
    "test:server": "node server/test_suite.js && node --test server/studioStore.test.js",
    "test:studio": "node --test server/studioStore.test.js",
    "build": "node scripts/build_dist.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "chemistry",
    "chemical-reactions",
    "reaction-mechanism",
    "molecular-visualization",
    "canvas",
    "pseudo-3d",
    "ccpl"
  ],
  "author": "XRJprogram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XRJprogram/Chemiation.git"
  },
  "bugs": {
    "url": "https://github.com/XRJprogram/Chemiation/issues"
  },
  "homepage": "https://github.com/XRJprogram/Chemiation#readme",
  "files": [
    "index.js",
    "js/",
    "css/",
    "index.html",
    "docs.html",
    "docs_en.html",
    "server/",
    "server.bat",
    "README.md"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
