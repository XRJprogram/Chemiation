# ============================================================
# CCPL 有机化学反应机理文件
# 规则：一个文件只包含一个反应方程式
# 坐标省略，由支持自动坐标解算的CCPL环境生成
# ============================================================

reaction "乙烯催化加氢"
equation "CH₂=CH₂ + H₂ → CH₃CH₃"
summary "烯烃双键在Ni、Pt或Pd催化下加氢，π键转化为σ键，生成烷烃。"

step "反应物与双键识别" {
  note "乙烯含有一个C=C双键；氢气在金属表面解离。考试重点：催化加氢属于加成反应。"
  atom C1 C
  atom C2 C
  atom H3 H
  atom H4 H
  atom H1a H
  atom H1b H
  atom H2a H
  atom H2b H
  bond C1 C2 2
  bond H3 H4 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C2 H2a 1
  bond C2 H2b 1
}

step "氢原子加成" {
  note "两个氢原子分别加到双键两端，C=C变为C-C，生成乙烷。"
  atom C1 C
  atom C2 C
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H2b H
  atom H2c H
  bond C1 C2 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond C2 H2c 1
}
