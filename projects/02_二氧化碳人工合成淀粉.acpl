  atom H6 H 2.40 1.80 0.50

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond C1 O1 2
  bond C1 O2 2
  bond H1 H2 1
  bond H3 H4 1
  bond H5 H6 1
}

