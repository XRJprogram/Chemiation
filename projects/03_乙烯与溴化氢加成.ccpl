# ============================================================
# CCPL 有机化学反应机理文件
# 规则：一个文件只包含一个反应方程式
# 坐标省略，由支持自动坐标解算的CCPL环境生成
# ============================================================

reaction "乙烯与溴化氢加成"
equation "CH₂=CH₂ + HBr → CH₃CH₂Br"
summary "烯烃与卤化氢发生亲电加成；本例乙烯对称，不涉及区域选择性。"

step "反应物" {
  note "HBr提供H⁺和Br⁻。"
  atom C1 C
  atom C2 C
  atom Br4 Br
  atom H1a H
  atom H1b H
  atom H2a H
  atom H2b H
  atom H4a H
  bond C1 C2 2
  bond C1 H1a 1
  bond C1 H1b 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond Br4 H4a 1
}

step "质子化形成碳正离子" {
  note "π键进攻H⁺，形成碳正离子。考试重点：不对称烯烃加HX通常按马氏规则判断主要产物。"
  atom C1 C
  atom C2 C charge=+1
  atom Br4 Br charge=-1
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H2b H
  bond C1 C2 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C2 H2a 1
  bond C2 H2b 1
}

step "卤离子进攻" {
  note "Br⁻进攻碳正离子，生成溴乙烷。"
  atom C1 C
  atom C2 C
  atom Br4 Br
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H2b H
  bond C1 C2 1
  bond C2 Br4 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C2 H2a 1
  bond C2 H2b 1
}
