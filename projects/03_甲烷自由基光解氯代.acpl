# ============================================================
# Chemiation 反应机理推演脚本 (ACPL)
# 反应名称: 甲烷自由基氯代反应机理
# 语法极简：只需指定步骤名称、机理说明与原子键连，三维坐标自动解算
# ============================================================

reaction "甲烷自由基氯代反应机理"
equation "CH₄ + Cl₂ —(hν)→ CH₃Cl + HCl"
category "自由基反应"
summary "经典烷烃自由基取代：光解均裂引发、高活性氯原子夺氢、甲基自由基偶联生成一氯甲烷与HCl。"

step "1. 反应物底物处于基态" {
  note "甲烷 (CH₄) 与氯气 (Cl-Cl) 空间共存，4 个 C-H 键构型稳定。"
  action "底物基态"

  # 原子定义: atom <ID> <元素> [可选X Y Z坐标]
  atom C1 C -2.40 0.00 0.00
  atom H1 H -2.40 1.80 0.00
  atom H2 H -0.90 -0.60 0.90
  atom H3 H -3.70 -0.60 0.90
  atom H4 H -2.40 -0.60 -1.70
  atom Cl1 Cl 2.00 0.00 0.40
  atom Cl2 Cl 3.80 0.00 -0.40

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond C1 H1 1
  bond C1 H2 1
  bond C1 H3 1
  bond C1 H4 1
  bond Cl1 Cl2 1
}

step "2. 光解均裂与自由基夺氢" {
  note "紫外光诱导 Cl-Cl 均裂断开，氯自由基夺取 H1 迁移生成 HCl 前体。"
  action "夺氢过渡"

  # 原子定义: atom <ID> <元素> [可选X Y Z坐标]
  atom C1 C -1.80 0.00 0.00
  atom H2 H -0.70 1.20 0.00
  atom H3 H -3.20 0.50 0.00
  atom H4 H -1.60 -1.70 0.00
  atom H1 H 1.10 0.30 0.20
  atom Cl1 Cl 2.50 0.30 0.20
  atom Cl2 Cl 0.60 -1.50 0.60

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond C1 H2 1
  bond C1 H3 1
  bond C1 H4 1
  bond H1 Cl1 1
}

step "3. 链传递产物生成" {
  note "甲基自由基与 Cl2 结合形成稳定的 C-Cl 单键，生成一氯甲烷与 HCl。"
  action "成键产物"

  # 原子定义: atom <ID> <元素> [可选X Y Z坐标]
  atom C1 C -0.60 0.00 0.00
  atom Cl2 Cl 1.50 0.00 0.00
  atom H2 H -1.20 1.30 0.80
  atom H3 H -1.20 -1.30 0.80
  atom H4 H -1.20 0.00 -1.70
  atom H1 H 3.40 1.40 0.50
  atom Cl1 Cl 4.80 1.40 0.50

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond C1 Cl2 1
  bond C1 H2 1
  bond C1 H3 1
  bond C1 H4 1
  bond H1 Cl1 1
}
