# ============================================================
# Chemiation 反应机理推演脚本 (CCPL)
# 反应名称: 哈伯-博施法合成氨机理
# 语法极简：只需指定步骤名称、机理说明与原子键连，三维坐标自动解算
# ============================================================

reaction "哈伯-博施法合成氨机理"
equation "N₂ + 3H₂ ⇌ 2NH₃"
summary "工业合成氨经典机理：N≡N三键与H-H协同解离活化、金属表面加氢、最终生成2个三角锥氨分子。"

step "1. 反应物分子表面吸附基态" {
  note "高键能 N≡N 分子与 3 个 H-H 氢分子吸附于铁催化剂表面晶格。"

  # 原子定义: atom <ID> <元素> [可选X Y Z坐标] [radical] [charge=+1/-1]
  atom N1 N -2.00 0.80 0.00
  atom N2 N -0.60 0.80 0.00
  atom H1 H 1.50 1.50 0.40
  atom H2 H 2.50 1.50 -0.20
  atom H4 H 1.50 0.00 -0.50
  atom H5 H 2.50 0.00 0.20
  atom H3 H 1.50 -1.50 0.30
  atom H6 H 2.50 -1.50 -0.40

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond N1 N2 3
  bond H1 H2 1
  bond H4 H5 1
  bond H3 H6 1
}

step "2. 协同解离与加氢过渡态" {
  note "催化剂反馈活化使 N≡N 与 H-H 键解离，迁移形成对称的 NH₂* 表面活性基团与就位氢分子。"

  # 原子定义: atom <ID> <元素> [可选X Y Z坐标] [radical] [charge=+1/-1]
  atom N1 N -2.00 0.20 0.00 radical
  atom H1 H -3.10 0.80 0.30
  atom H2 H -2.80 -0.80 -0.30
  atom N2 N 2.00 0.20 0.00 radical
  atom H4 H 3.10 0.80 -0.30
  atom H5 H 2.80 -0.80 0.30
  atom H3 H -0.55 -1.20 0.00
  atom H6 H 0.55 -1.20 0.00

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond N1 H1 1
  bond N1 H2 1
  bond N2 H4 1
  bond N2 H5 1
  bond H3 H6 1
}

step "3. 终步加氢完成生成氨气" {
  note "全部氢原子与氮彻底键合，生成稳定闭壳构型的 2 个氨分子 (2 NH₃) 并脱附释放。"

  # 原子定义: atom <ID> <元素> [可选X Y Z坐标] [radical] [charge=+1/-1]
  atom N1 N -2.40 0.30 0.00
  atom H1 H -2.40 -0.70 1.40
  atom H2 H -1.20 -0.70 -0.70
  atom H3 H -3.60 -0.70 -0.70
  atom N2 N 2.40 0.30 0.00
  atom H4 H 2.40 -0.70 1.40
  atom H5 H 3.60 -0.70 -0.70
  atom H6 H 1.20 -0.70 -0.70

  # 化学键拓扑: bond <原子1> <原子2> [键级1/2/3]
  bond N1 H1 1
  bond N1 H2 1
  bond N1 H3 1
  bond N2 H4 1
  bond N2 H5 1
  bond N2 H6 1
}
