# ============================================================
# CCPL 有机化学反应机理文件
# 规则：一个文件只包含一个反应方程式
# 坐标省略，由支持自动坐标解算的CCPL环境生成
# ============================================================

reaction "乙炔水合制乙醛"
equation "HC≡CH + H₂O → CH₃CHO"
summary "乙炔在HgSO₄/H₂SO₄催化下水合，先形成烯醇，再发生酮-烯醇互变异构生成乙醛。"

step "乙炔与水" {
  note "乙炔的三键可发生加成；条件通常为HgSO₄/H₂SO₄。"
  atom C1 C
  atom C2 C
  atom O3 O
  atom H1a H
  atom H2a H
  atom H3a H
  atom H3b H
  bond C1 C2 3
  bond C1 H1a 1
  bond C2 H2a 1
  bond O3 H3a 1
  bond O3 H3b 1
}

step "生成烯醇中间体" {
  note "水的H和OH分别加到三键两端，先得到烯醇CH₂=CHOH。"
  atom C1 C
  atom C2 C
  atom O3 O
  atom H1a H
  atom H1b H
  atom H2a H
  atom H3a H
  bond C1 C2 2
  bond C2 O3 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C2 H2a 1
  bond O3 H3a 1
}

step "烯醇互变异构" {
  note "发生质子迁移和双键位置变化，形成羰基，最终得到乙醛。考试重点：不要把烯醇中间体误认为最终产物。"
  atom C1 C
  atom C2 C
  atom O3 O
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  bond C1 C2 1
  bond C2 O3 2
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C2 H2a 1
}
