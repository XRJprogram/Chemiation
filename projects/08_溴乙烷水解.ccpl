reaction "溴乙烷水解"
equation "CH₃CH₂Br + NaOH(aq) → CH₃CH₂OH + NaBr"
summary "OH⁻作为亲核试剂进攻卤代烃碳原子，Br⁻离去，发生亲核取代。"

step "亲核试剂接近" {
  note "水溶液中的OH⁻是亲核试剂。"
  atom C1 C
  atom C2 C
  atom Br3 Br
  atom O4 O charge=-1
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H2b H
  atom H4a H
  bond C1 C2 1
  bond C2 Br3 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond O4 H4a 1
}

step "亲核取代产物" {
  note "C-O键形成，C-Br键断裂。考试重点：NaOH水溶液、加热通常考取代；NaOH醇溶液、加热通常考消除。"
  atom C1 C
  atom C2 C
  atom O4 O
  atom Br3 Br charge=-1
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H2b H
  atom H4a H
  bond C1 C2 1
  bond C2 O4 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond O4 H4a 1
}
