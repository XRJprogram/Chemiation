# ============================================================
# CCPL 有机化学反应机理文件
# 规则：一个文件只包含一个反应方程式
# 坐标省略，由支持自动坐标解算的CCPL环境生成
# ============================================================

reaction "甲醚与氢碘酸反应"
equation "CH₃OCH₃ + HI → CH₃I + CH₃OH"
summary "醚氧先质子化，随后I⁻对烷基碳发生亲核取代，使C-O键断裂。"

step "醚与HI" {
  note "醚氧具有孤对电子，可接受质子。"
  atom C1 C
  atom O2 O
  atom C3 C
  atom I5 I
  atom H1a H
  atom H1b H
  atom H1c H
  atom H3a H
  atom H3b H
  atom H3c H
  atom H5a H
  bond C1 O2 1
  bond O2 C3 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C3 H3a 1
  bond C3 H3b 1
  bond C3 H3c 1
  bond I5 H5a 1
}

step "氧原子质子化" {
  note "形成氧鎓离子，C-O键更容易断裂。"
  atom C1 C
  atom O2 O charge=+1
  atom C3 C
  atom I5 I charge=-1
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H3a H
  atom H3b H
  atom H3c H
  bond C1 O2 1
  bond O2 C3 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond O2 H2a 1
  bond C3 H3a 1
  bond C3 H3b 1
  bond C3 H3c 1
}

step "碘离子亲核进攻" {
  note "I⁻进攻甲基，生成碘甲烷和甲醇。过量HI并加热时，甲醇还可继续转化为CH₃I。"
  atom C1 C
  atom I5 I
  atom C3 C
  atom O2 O
  atom H1a H
  atom H1b H
  atom H1c H
  atom H3a H
  atom H3b H
  atom H3c H
  atom H2a H
  bond C1 I5 1
  bond C3 O2 1
  bond C1 H1a 1
  bond C1 H1b 1
  bond C1 H1c 1
  bond C3 H3a 1
  bond C3 H3b 1
  bond C3 H3c 1
  bond O2 H2a 1
}
