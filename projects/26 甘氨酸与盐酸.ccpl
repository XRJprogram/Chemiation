reaction "甘氨酸与盐酸反应"
equation "H₂NCH₂COOH + HCl → [H₃NCH₂COOH]Cl"
summary "氨基酸中的氨基具有碱性，可接受质子形成铵盐。"

step "甘氨酸与酸" {
  note "氨基酸含有氨基和羧基，氨基可接受H⁺。"
  atom N1 N
  atom C2 C
  atom C3 C
  atom O4 O
  atom O5 O
  atom H6 H charge=+1
  atom Cl7 Cl charge=-1
  atom H1a H
  atom H1b H
  atom H2a H
  atom H2b H
  atom H5a H
  bond N1 C2 1
  bond C2 C3 1
  bond C3 O4 2
  bond C3 O5 1
  bond N1 H1a 1
  bond N1 H1b 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond O5 H5a 1
}

step "氨基质子化" {
  note "形成铵盐。考试重点：氨基酸具有两性，酸性条件下主要以阳离子形式存在。"
  atom N1 N charge=+1
  atom C2 C
  atom C3 C
  atom O4 O
  atom O5 O
  atom Cl7 Cl charge=-1
  atom H1a H
  atom H1b H
  atom H1c H
  atom H2a H
  atom H2b H
  atom H5a H
  bond N1 C2 1
  bond C2 C3 1
  bond C3 O4 2
  bond C3 O5 1
  bond N1 H1a 1
  bond N1 H1b 1
  bond N1 H1c 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond O5 H5a 1
}
