reaction "甘氨酸脱羧反应"
equation "H₂NCH₂COOH → CH₃NH₂ + CO₂"
summary "脱羧酶催化氨基酸脱去羧基中的CO₂，生成相应胺。"

step "甘氨酸结构" {
  note "羧基中的碳最终以CO₂形式脱去。"
  atom N1 N
  atom C2 C
  atom C3 C
  atom O4 O
  atom O5 O
  atom H1a H
  atom H1b H
  atom H2a H
  atom H2b H
  atom H5a H
  bond N1 C2 1
  bond C2 C3 1
  bond C3 O4 2
  bond C3 O5 1
  bond N1 H1a 1
  bond N1 H1b 1
  bond C2 H2a 1
  bond C2 H2b 1
  bond O5 H5a 1
}

step "脱羧产物" {
  note "生成甲胺和CO₂。考试重点：氨基酸脱羧产物比原氨基酸少一个碳原子。"
  atom C2 C
  atom N1 N
  atom O4 O
  atom C3 C
  atom O5 O
  atom H2a H
  atom H2b H
  atom H2c H
  atom H1a H
  atom H1b H
  bond C2 N1 1
  bond O4 C3 2
  bond C3 O5 2
  bond C2 H2a 1
  bond C2 H2b 1
  bond C2 H2c 1
  bond N1 H1a 1
  bond N1 H1b 1
}
