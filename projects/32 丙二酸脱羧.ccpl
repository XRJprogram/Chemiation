  bond C5 O6 2
  bond C5 O7 1
  bond O1 H1a 1
  bond C4 H4a 1
  bond C4 H4b 1
  bond O7 H7a 1
}

step "脱羧产物" {
  note "一个羧基转化为CO₂，剩余部分形成乙酸。考试重点：丙二酸及其衍生物常考脱羧。"
