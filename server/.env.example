# Upstash Redis Serverless Cloud Credentials
# Create a free Redis database at https://console.upstash.com
# Copy the REST API details (UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN)

UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Namespace key prefix to isolate Chemiation data from other projects sharing this Redis instance
UPSTASH_REDIS_PREFIX=chemiation:
